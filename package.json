{
  "name": "recalldeck",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run build:api && ng build",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "start": "node dist/api/main.js",
    "dev:api": "APP_ORIGIN=http://localhost:5178 tsx watch apps/api/src/main.ts",
    "dev:web": "ng serve --host 0.0.0.0 --port 5178",
    "test": "tsx --test apps/api/test/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@playwright/test": "1.65.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=24.22.0 <25"
  }
}
